import pandas as pd

# Creating sample student data
data = {
    'Name': ['Alice', 'Bob', 'Charlie', 'David', 'Bob', 'Eva'],
    'Marks': [85, None, 90, 75, None, 88],
    'City': ['Pune', 'Mumbai', None, 'Delhi', 'Mumbai', 'Pune'],
    'Remarks': ['Good', 'Average', 'Good', 'Average', 'Average', 'Good']
}

df = pd.DataFrame(data)

print("Original DataFrame:")
print(df)

# Removing rows with missing values
print("\nAfter dropna():")
print(df.dropna())

# Filling missing values
df['Marks'] = df['Marks'].fillna(df['Marks'].mean())
df['City'] = df['City'].fillna('Unknown')

print("\nAfter fillna():")
print(df)

# Checking duplicate records
print("\nDuplicate Records:")
print(df.duplicated())

# Removing duplicates
df = df.drop_duplicates()

print("\nAfter Removing Duplicates:")
print(df)

# Removing irrelevant column
df = df.drop('Remarks', axis=1)

print("\nAfter Removing Remarks Column:")
print(df)

# Filtering students with marks >= 80
filtered_df = df.loc[df['Marks'] >= 80]

print("\nFiltered Data:")
print(filtered_df)